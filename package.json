{
  "name": "whatsloaded",
  "version": "0.2.0",
  "description": "See, measure, diagnose, and safely manage the MCP servers, skills, agents, rules, and plugins loaded across your AI coding tools.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "kiro",
    "opencode",
    "ai-agents",
    "agent-skills",
    "context-window",
    "developer-tools",
    "cli",
    "tui"
  ],
  "type": "module",
  "bin": {
    "whatsloaded": "dist/cli.js"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:api": "tsx src/cli.ts ui --no-open",
    "dev:web": "vite",
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-terms": "node scripts/check-terms.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@decimalturn/toml-patch": "^3.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "react": "^19.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "radix-ui": "^1.8.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/bvamc/whatsloaded#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvamc/whatsloaded.git"
  },
  "bugs": {
    "url": "https://github.com/bvamc/whatsloaded/issues"
  }
}
